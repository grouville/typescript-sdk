"""
End-to-end checks for the TypeScript SDK helper module.
"""
type E2e {
  let fixtureRoot: String! = ".dagger/modules/e2e/fixtures"
  let outputRoot: String! = ".dagger/modules/e2e/out"

  let lookupModulePath: String! = fixtureRoot + "/lookup/app"
  let lookupNestedPath: String! = lookupModulePath + "/nested"
  let nonTsModulePath: String! = fixtureRoot + "/lookup/not-ts"
  let skipModulePath: String! = fixtureRoot + "/skip/app"
  let generateModulePath: String! = fixtureRoot + "/generate/app"
  let depsModulePath: String! = fixtureRoot + "/deps/app"
  let existingNodePath: String! = fixtureRoot + "/init-existing/node-app"
  let existingDenoPath: String! = fixtureRoot + "/init-existing/deno-app"
  let existingBunPath: String! = fixtureRoot + "/init-existing/bun-app"
  let configModulePath: String! = fixtureRoot + "/config/app"
  let configuredModulePath: String! = fixtureRoot + "/config/configured"
  let configuredDenoModulePath: String! = fixtureRoot + "/config/configured-deno"
  let configBareModulePath: String! = fixtureRoot + "/config/bare"

  # A client binds to the client/app module (which depends on client/dep) and is
  # generated into its own dir.
  let clientModulePath: String! = fixtureRoot + "/client/app"
  let clientOutputPath: String! = fixtureRoot + "/client/out"
  # A client dir that already has a package.json pointing @dagger.io/dagger at a
  # local bundle; regeneration must preserve it.
  let clientExistingPath: String! = fixtureRoot + "/client/existing"

  # dagger/dagger commit whose sdk/typescript builds the @dagger.io/dagger the
  # compile check type-checks against. Pinned to a commit (not a branch) so
  # Dagger content-addresses the whole SDK build and reuses it across runs — a
  # branch re-resolves HEAD every run and rebuilds. Bump to track main.
  let daggerSourceRef: String! = "944ff62a6a768e91fc72519f343e50da2c77d889"

  """
  Fail the current check when a condition is false.
  """
  let assert(condition: Boolean!, message: String!): Void {
    if (condition == false) {
      raise message
    }
    null
  }

  """
  Return true when a list contains the exact string.
  """
  let contains(values: [String!]!, want: String!): Boolean! {
    values
      .filter { value => value == want }
      .length > 0
  }

  """
  Assert that a changeset added a path.
  """
  let assertAdded(changes: Changeset!, path: String!): Void {
    assert(contains(changes.addedPaths, path), "expected added path: " + path)
  }

  """
  Assert that a changeset generated a path — added on a fresh dir, or modified
  when the client output already exists (e.g. from a prior `dagger generate`).
  """
  let assertGenerated(changes: Changeset!, path: String!): Void {
    assert(
      contains(changes.addedPaths, path) or contains(changes.modifiedPaths, path),
      "expected generated (added or modified) path: " + path,
    )
  }

  """
  Assert that a string contains a substring.
  """
  let assertContains(value: String!, want: String!, message: String!): Void {
    assert(value.contains(want), message)
  }

  """
  Assert that a string does not contain a substring.
  """
  let assertNotContains(value: String!, want: String!, message: String!): Void {
    assert(value.contains(want) == false, message)
  }

  """
  Assert that a config edit modified only the named file (no adds, no removes).
  """
  let assertOnlyFileChanged(changes: Changeset!, path: String!, message: String!): Void {
    assert(contains(changes.modifiedPaths, path), message + ": did not modify " + path)
    assert(changes.modifiedPaths.length == 1, message + ": modified more than one file")
    assert(changes.addedPaths.length == 0, message + ": should not add files")
    assert(changes.removedPaths.length == 0, message + ": should not remove files")
  }

  """
  The helper should expose the generate skip marker used by callers.
  """
  pub skipGenerateFilenameCheck: Void @check {
    assert(typescriptSdk.skipGenerateFilename == ".dagger-typescript-sdk-skip-generate", "skip marker filename changed")

    null
  }

  """
  Mod lookup should find the owning TypeScript SDK module when called from a nested path.
  """
  pub moduleLookupCheck(ws: Workspace!): Void @check {
    let nested = typescriptSdk.mod(ws, path: lookupNestedPath)
    let exact = typescriptSdk.mod(ws, path: lookupModulePath, findUp: false)

    assert(nested.path == lookupModulePath, "find-up lookup returned the wrong module path")
    assert(exact.path == lookupModulePath, "exact lookup returned the wrong module path")

    null
  }

  """
  The SDK should report the builtin runtime it targets.
  """
  pub targetRuntimeCheck: Void @check {
    assert(typescriptSdk.targetRuntime == "typescript", "targetRuntime should be typescript")

    null
  }

  """
  initModule should produce only the SDK-owned seed files. The engine owns the
  module's dagger.json, so it must not appear in the changeset.
  """
  pub initCheck(ws: Workspace!): Void @check {
    let defaultPath = outputRoot + "/init-default"
    let bunPath = outputRoot + "/init-bun"
    let denoPath = outputRoot + "/init-deno"

    let defaultChanges = typescriptSdk.initModule(ws, name: "init-default", path: defaultPath)
    let bunChanges = typescriptSdk.initModule(ws, name: "init-bun", path: bunPath, runtime: TypescriptSdkRuntime.BUN)
    let denoChanges = typescriptSdk.initModule(ws, name: "init-deno", path: denoPath, runtime: TypescriptSdkRuntime.DENO)

    assert(contains(defaultChanges.addedPaths, defaultPath + "/dagger.json") == false, "initModule should not write dagger.json; the engine owns it")
    assertAdded(defaultChanges, defaultPath + "/src/index.ts")
    assertAdded(defaultChanges, defaultPath + "/package.json")
    assertAdded(defaultChanges, defaultPath + "/tsconfig.json")
    assert(contains(defaultChanges.addedPaths, defaultPath + "/index.ts") == false, "init should not generate index.ts at the module root")
    assert(contains(defaultChanges.addedPaths, defaultPath + "/deno.json") == false, "node init should not generate deno.json")
    assert(contains(defaultChanges.addedPaths, defaultPath + "/bun.lock") == false, "node init should not generate bun.lock")
    assert(defaultChanges.modifiedPaths.length == 0, "init unexpectedly modified existing files")
    assert(defaultChanges.removedPaths.length == 0, "init unexpectedly removed files")

    assertAdded(bunChanges, bunPath + "/src/index.ts")
    assertAdded(bunChanges, bunPath + "/package.json")
    assertAdded(bunChanges, bunPath + "/tsconfig.json")
    assertAdded(bunChanges, bunPath + "/bun.lock")

    assertAdded(denoChanges, denoPath + "/src/index.ts")
    assertAdded(denoChanges, denoPath + "/deno.json")
    assert(contains(denoChanges.addedPaths, denoPath + "/package.json") == false, "deno init should not generate package.json")
    assert(contains(denoChanges.addedPaths, denoPath + "/tsconfig.json") == false, "deno init should not generate tsconfig.json")

    null
  }

  """
  Init against a path that already contains user-authored package.json,
  tsconfig.json, or deno.json should merge Dagger-required keys into those
  files instead of clobbering them.
  """
  pub initRespectsExistingCheck(ws: Workspace!): Void @check {
    let nodeChanges = typescriptSdk.initModule(ws, name: "init-existing-node", path: existingNodePath)
    let denoChanges = typescriptSdk.initModule(ws, name: "init-existing-deno", path: existingDenoPath, runtime: TypescriptSdkRuntime.DENO)
    let bunChanges = typescriptSdk.initModule(ws, name: "init-existing-bun", path: existingBunPath, runtime: TypescriptSdkRuntime.BUN)

    # Existing user files should be modified (merged), not added fresh.
    assert(contains(nodeChanges.modifiedPaths, existingNodePath + "/package.json"), "existing package.json should be merged, not added")
    assert(contains(nodeChanges.modifiedPaths, existingNodePath + "/tsconfig.json"), "existing tsconfig.json should be merged, not added")
    assert(contains(nodeChanges.addedPaths, existingNodePath + "/package.json") == false, "package.json should not be reported as added when it already existed")
    assert(contains(nodeChanges.addedPaths, existingNodePath + "/tsconfig.json") == false, "tsconfig.json should not be reported as added when it already existed")

    let mergedPkg = nodeChanges.layer.file(existingNodePath + "/package.json").contents
    assertContains(mergedPkg, "\"name\": \"user-pkg\"", "user-authored name key should be preserved")
    assertContains(mergedPkg, "\"version\": \"1.2.3\"", "user-authored version key should be preserved")
    assertContains(mergedPkg, "\"build\": \"tsc\"", "user-authored script should be preserved")
    assertContains(mergedPkg, "\"type\":\"module\"", "Dagger-required type=module should be added")
    assertNotContains(mergedPkg, "\"@dagger.io/dagger\"", "legacy in-tree @dagger.io/dagger devDependency should be stripped")

    let mergedTsConfig = nodeChanges.layer.file(existingNodePath + "/tsconfig.json").contents
    assertContains(mergedTsConfig, "\"target\": \"ES2020\"", "user-authored compiler target should be preserved")
    assertContains(mergedTsConfig, "\"strict\": true", "user-authored strict flag should be preserved")
    assertContains(mergedTsConfig, "\"@user/lib\"", "user-authored path mapping should be preserved")
    assertContains(mergedTsConfig, "\"experimentalDecorators\":true", "Dagger-required experimentalDecorators should be added")
    assertContains(mergedTsConfig, "\"@dagger.io/dagger\"", "Dagger SDK path mapping should be added")
    assertContains(mergedTsConfig, "\"@dagger.io/dagger/telemetry\"", "Dagger telemetry path mapping should be added")

    assert(contains(denoChanges.modifiedPaths, existingDenoPath + "/deno.json"), "existing deno.json should be merged, not added")
    assert(contains(denoChanges.addedPaths, existingDenoPath + "/deno.json") == false, "deno.json should not be reported as added when it already existed")

    let mergedDeno = denoChanges.layer.file(existingDenoPath + "/deno.json").contents
    assertContains(mergedDeno, "\"dev\": \"deno run main.ts\"", "user-authored deno task should be preserved")
    assertContains(mergedDeno, "\"@user/lib\"", "user-authored deno import should be preserved")
    assertContains(mergedDeno, "\"kv\"", "user-authored unstable flag should be preserved")
    assertContains(mergedDeno, "\"@dagger.io/dagger\"", "Dagger SDK import should be added")
    assertContains(mergedDeno, "\"nodeModulesDir\":\"auto\"", "Dagger-required nodeModulesDir should be added")
    assertContains(mergedDeno, "\"experimentalDecorators\":true", "Dagger-required experimentalDecorators should be added")
    assertContains(mergedDeno, "\"bare-node-builtins\"", "Dagger-required unstable flag should be appended")

    # bun init should not overwrite or add an existing bun.lock; the fixture's
    # lockfile content is non-JSON so any "merge" would corrupt it.
    assert(contains(bunChanges.addedPaths, existingBunPath + "/bun.lock") == false, "existing bun.lock should not be reported as added")
    assert(contains(bunChanges.modifiedPaths, existingBunPath + "/bun.lock") == false, "existing bun.lock should not be modified")

    null
  }

  """
  Generating an existing module should produce generated files rooted at that
  module without touching unrelated paths.
  """
  pub generateCheck(ws: Workspace!): Void @check {
    let changes = typescriptSdk.mod(ws, path: generateModulePath).generate(ws)

    assertGenerated(changes, generateModulePath + "/sdk/index.ts")

    null
  }

  """
  Generating all modules should discover TypeScript SDK modules and ignore skipped ones.
  """
  pub generateAllCheck(ws: Workspace!): Void @check {
    let changes = typescriptSdk.generateAllModule(ws)

    assertGenerated(changes, generateModulePath + "/sdk/index.ts")
    assert(contains(changes.addedPaths, lookupModulePath + "/src/index.ts") == false, "generateAll generated a lookup fixture that should be skipped")
    assert(contains(changes.addedPaths, depsModulePath + "/src/index.ts") == false, "generateAll generated dependency fixtures that should be skipped")
    assert(contains(changes.addedPaths, skipModulePath + "/src/index.ts") == false, "generateAll generated a skipped module")
    assert(contains(changes.addedPaths, nonTsModulePath + "/src/index.ts") == false, "generateAll generated a non-TypeScript SDK module")

    null
  }

  """
  Generating a client for a module should produce a scoped-package client:
  dagger.gen.ts (core types), one <module>.gen.ts per module (the bound module
  plus its deps), and package.json — rooted at the client output path.
  """
  pub generateClientCheck(ws: Workspace!): Void @check {
    let changes = typescriptSdk.generateClient(ws, module: clientModulePath, path: clientOutputPath)

    assertGenerated(changes, clientOutputPath + "/dagger.gen.ts")
    assertGenerated(changes, clientOutputPath + "/client-app.gen.ts")
    assertGenerated(changes, clientOutputPath + "/package.json")
    assertGenerated(changes, clientOutputPath + "/tsconfig.json")

    null
  }

  """
  A generated client must type-check. The bindings extend `BaseClient`, which no
  published @dagger.io/dagger exports yet, so build the library from dagger `main`
  and `tsc --noEmit` the generated client against it — catching binding/tsconfig
  bugs that file-presence checks miss.
  """
  pub generateClientCompilesCheck(ws: Workspace!): Void @check {
    let changes = typescriptSdk.generateClient(ws, module: clientModulePath, path: clientOutputPath)
    let clientDir = changes.layer.directory(clientOutputPath)

    let node = container
      .from("node:22-alpine")
      .withMountedCache("/root/.npm", cacheVolume("npm-cache"))

    # Build @dagger.io/dagger from source (pinned dagger commit). npm needs
    # --legacy-peer-deps for the SDK's graphql peer range. The pinned tree makes
    # this whole chain cache: after the first build, later runs reuse the layer
    # and the npm cache volume backs the first build's downloads.
    let daggerLib = node
      .withDirectory("/build", git("https://github.com/dagger/dagger").commit(daggerSourceRef).tree.directory("sdk/typescript"))
      .withWorkdir("/build")
      .withExec(["npm", "install", "--no-audit", "--no-fund", "--legacy-peer-deps"])
      .withExec(["npm", "run", "build"])
      .directory("/build")

    # Point the client's @dagger.io/dagger at the built lib (npm install of a
    # local path overrides the version pin) and type-check.
    let out = node
      .withDirectory("/dagger-lib", daggerLib)
      .withDirectory("/client", clientDir)
      .withWorkdir("/client")
      .withExec(["npm", "install", "--no-audit", "--no-fund", "--legacy-peer-deps", "/dagger-lib", "typescript@5.9.3"])
      .withExec(["npx", "--no-install", "tsc", "--noEmit"])
      .stdout

    null
  }

  """
  Regenerating a client whose package.json already points @dagger.io/dagger at a
  local bundle must preserve that dependency (not overwrite it with the engine
  version pin), and the emitted package.json must be pretty-printed.
  """
  pub generateClientRespectsExistingCheck(ws: Workspace!): Void @check {
    let changes = typescriptSdk.generateClient(ws, module: clientModulePath, path: clientExistingPath)

    # The "./sdk" value proves the local ref is preserved; the ": " (space after
    # colon) proves the output is pretty-printed, not a single minified line.
    let pkg = changes.layer.file(clientExistingPath + "/package.json").contents
    assertContains(pkg, "\"@dagger.io/dagger\": \"./sdk\"", "existing local @dagger.io/dagger ref must be preserved and pretty-printed")
    assertContains(pkg, "\"name\": \"my-existing-client\"", "existing package name must be preserved")

    null
  }

  """
  Regenerating all workspace-registered clients should generate each one at its
  configured path.
  """
  pub generateAllClientCheck(ws: Workspace!): Void @check {
    let changes = typescriptSdk.generateAllClient(ws)

    assertGenerated(changes, clientOutputPath + "/dagger.gen.ts")
    assertGenerated(changes, clientOutputPath + "/client-app.gen.ts")
    assertGenerated(changes, clientOutputPath + "/package.json")
    assertGenerated(changes, clientOutputPath + "/tsconfig.json")

    null
  }

  """
  The Go helpers (codegen, config-updator) must pass their own unit + golden
  tests. Runs `go test` in a container so `dagger check` covers the codegen
  logic, not just its end-to-end output.
  """
  pub helperTestsCheck(ws: Workspace!): Void @check {
    let out = container
      .from("golang:1.25-alpine")
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withDirectory("/helpers", ws.directory("helpers"))
      .withWorkdir("/helpers/codegen")
      .withExec(["go", "test", "./..."])
      .withWorkdir("/helpers/config-updator")
      .withExec(["go", "test", "./..."])
      .stdout

    null
  }

  """
  A skip marker above a module should make generate return an empty changeset.
  """
  pub skipGenerateCheck(ws: Workspace!): Void @check {
    let mod = typescriptSdk.mod(ws, path: skipModulePath)
    let changes = mod.generate(ws)

    assert(mod.skipGenerate(ws), "skip marker was not detected")
    assert(changes.isEmpty, "generate returned changes for a skipped module")

    null
  }

  """
  Config readers should reflect package.json (or deno.json), and mutators
  should edit only the targeted config file while preserving unrelated keys.
  """
  pub configCheck(ws: Workspace!): Void @check {
    let app = typescriptSdk.mod(ws, path: configModulePath).config
    let configured = typescriptSdk.mod(ws, path: configuredModulePath).config
    let configuredDeno = typescriptSdk.mod(ws, path: configuredDenoModulePath).config

    # Defaults: unconfigured node module reads empty.
    assert(app.packageManager == "", "default packageManager should be empty")
    assert(app.baseImage == "", "default baseImage should be empty")

    # Configured node module reads the override values.
    assert(configured.packageManager == "pnpm@8.15.4", "configured packageManager should read pnpm@8.15.4")
    assert(configured.baseImage == "node:23.2.0-alpine", "configured baseImage should read the override")

    # Deno module: no package.json, baseImage comes from deno.json.
    assert(configuredDeno.packageManager == "", "deno-only module should expose no packageManager")
    assert(configuredDeno.baseImage == "denoland/deno:alpine-2.0.0", "deno baseImage should read from deno.json")

    let appPkg = configModulePath + "/package.json"

    # Single-flag set: package manager only.
    let pm = app.set(packageManager: "yarn@1.22.22")
    assertOnlyFileChanged(pm, appPkg, "set(packageManager)")
    assertContains(pm.after.file(appPkg).contents, "yarn@1.22.22", "set(packageManager) did not write the value")
    assertContains(pm.after.file(appPkg).contents, "\"type\": \"module\"", "set(packageManager) dropped unrelated keys")

    # Single-flag set: base image only.
    let img = app.set(baseImage: "node:23.2.0-alpine")
    assertOnlyFileChanged(img, appPkg, "set(baseImage)")
    assertContains(img.after.file(appPkg).contents, "node:23.2.0-alpine", "set(baseImage) did not write the image")

    # Both flags in one call: a single file change carrying both edits.
    let both = app.set(packageManager: "npm@10.7.0", baseImage: "node:23.2.0-alpine")
    assertOnlyFileChanged(both, appPkg, "set(packageManager, baseImage)")
    assertContains(both.after.file(appPkg).contents, "npm@10.7.0", "set(both) did not write packageManager")
    assertContains(both.after.file(appPkg).contents, "node:23.2.0-alpine", "set(both) did not write baseImage")

    let configuredPkg = configuredModulePath + "/package.json"

    let unsetPm = configured.unsetPackageManager
    assertOnlyFileChanged(unsetPm, configuredPkg, "unsetPackageManager")
    assertNotContains(unsetPm.after.file(configuredPkg).contents, "packageManager", "unsetPackageManager left the field")
    assertContains(unsetPm.after.file(configuredPkg).contents, "node:23.2.0-alpine", "unsetPackageManager clobbered dagger.baseImage")

    let unsetImg = configured.unsetBaseImage
    assertOnlyFileChanged(unsetImg, configuredPkg, "unsetBaseImage")
    assertNotContains(unsetImg.after.file(configuredPkg).contents, "baseImage", "unsetBaseImage left the override")
    assertContains(unsetImg.after.file(configuredPkg).contents, "pnpm@8.15.4", "unsetBaseImage clobbered packageManager")

    # Deno modules: baseImage edits route to deno.json, not package.json.
    let configuredDenoFile = configuredDenoModulePath + "/deno.json"

    let denoImg = configuredDeno.set(baseImage: "denoland/deno:latest")
    assertOnlyFileChanged(denoImg, configuredDenoFile, "set(baseImage) on deno module")
    assertContains(denoImg.after.file(configuredDenoFile).contents, "denoland/deno:latest", "set(baseImage) did not write to deno.json")

    let unsetDenoImg = configuredDeno.unsetBaseImage
    assertOnlyFileChanged(unsetDenoImg, configuredDenoFile, "unsetBaseImage on deno module")
    assertNotContains(unsetDenoImg.after.file(configuredDenoFile).contents, "baseImage", "unsetBaseImage left the override in deno.json")
    assertContains(unsetDenoImg.after.file(configuredDenoFile).contents, "nodeModulesDir", "unsetBaseImage clobbered unrelated deno keys")

    # unset-package-manager on a Deno module is a no-op: there is no
    # package.json, and the unset must not fabricate an empty one.
    let denoUnsetPm = configuredDeno.unsetPackageManager
    assert(denoUnsetPm.isEmpty, "unsetPackageManager on a Deno module should be a no-op")
    assert(contains(denoUnsetPm.addedPaths, configuredDenoModulePath + "/package.json") == false, "unsetPackageManager must not create a package.json in a Deno module")

    # Bare module (no package.json or deno.json): readers are empty and the
    # unsetters are no-ops that never write a stray config file.
    let bare = typescriptSdk.mod(ws, path: configBareModulePath).config
    assert(bare.packageManager == "", "bare module should expose no packageManager")
    assert(bare.baseImage == "", "bare module should expose no baseImage")

    let bareUnsetPm = bare.unsetPackageManager
    assert(bareUnsetPm.isEmpty, "unsetPackageManager on a module without package.json should be a no-op")
    assert(contains(bareUnsetPm.addedPaths, configBareModulePath + "/package.json") == false, "unsetPackageManager must not fabricate a package.json")

    let bareUnsetImg = bare.unsetBaseImage
    assert(bareUnsetImg.isEmpty, "unsetBaseImage on a module without a config file should be a no-op")
    assert(contains(bareUnsetImg.addedPaths, configBareModulePath + "/package.json") == false, "unsetBaseImage must not fabricate a package.json")

    null
  }

  """
  Init flags should write configuration into the generated config files. By
  default, no config keys are written; the runtime decides which file the
  base image override lands in.
  """
  pub initConfigCheck(ws: Workspace!): Void @check {
    let configuredPath = outputRoot + "/init-configured"
    let configuredDenoPath = outputRoot + "/init-configured-deno"
    let defaultPath = outputRoot + "/init-config-default"

    let configured = typescriptSdk.initModule(ws, name: "init-configured", path: configuredPath, packageManager: "pnpm@8.15.4", baseImage: "node:23.2.0-alpine")
    let pkg = configuredPath + "/package.json"
    assertAdded(configured, pkg)
    assert(configured.modifiedPaths.length == 0, "configured init should not modify existing files")
    assert(configured.removedPaths.length == 0, "configured init should not remove files")
    assertContains(configured.layer.file(pkg).contents, "pnpm@8.15.4", "init --package-manager not written")
    assertContains(configured.layer.file(pkg).contents, "node:23.2.0-alpine", "init --base-image not written")

    # Deno init with baseImage routes to deno.json; no package.json is created.
    let configuredDeno = typescriptSdk.initModule(ws, name: "init-configured-deno", path: configuredDenoPath, runtime: TypescriptSdkRuntime.DENO, baseImage: "denoland/deno:alpine-2.0.0")
    let denoFile = configuredDenoPath + "/deno.json"
    assertAdded(configuredDeno, denoFile)
    assertContains(configuredDeno.layer.file(denoFile).contents, "denoland/deno:alpine-2.0.0", "init deno --base-image not written")
    assert(contains(configuredDeno.addedPaths, configuredDenoPath + "/package.json") == false, "deno init should not generate package.json even with baseImage")

    # Default init has no config keys.
    let default = typescriptSdk.initModule(ws, name: "init-config-default", path: defaultPath)
    let defaultPkg = defaultPath + "/package.json"
    assertAdded(default, defaultPkg)
    assertNotContains(default.layer.file(defaultPkg).contents, "packageManager", "default init should not write packageManager")
    assertNotContains(default.layer.file(defaultPkg).contents, "baseImage", "default init should not write baseImage")

    null
  }

  """
  Listing modules in a workspace should return every module whose
  dagger.json declares the TypeScript SDK, and nothing else.
  """
  pub modulesCheck(ws: Workspace!): Void @check {
    let pathRecords = typescriptSdk.modules(ws).{path}

    assert(pathRecords.filter { r => r.path == lookupModulePath }.length > 0, "lookup TypeScript module should be listed")
    assert(pathRecords.filter { r => r.path == skipModulePath }.length > 0, "skip-marked TypeScript module should still be listed (skip only affects generate)")
    assert(pathRecords.filter { r => r.path == generateModulePath }.length > 0, "generate TypeScript module should be listed")
    assert(pathRecords.filter { r => r.path == depsModulePath }.length > 0, "deps TypeScript module should be listed")
    assert(pathRecords.filter { r => r.path == nonTsModulePath }.length == 0, "non-TypeScript SDK module should be excluded from modules listing")

    null
  }
}
